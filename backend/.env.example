# ══════════════════════════════════════════
# Chizze Backend — Environment Variables
# ══════════════════════════════════════════

# Server
PORT=8080
GIN_MODE=debug  # debug | release | test

# Appwrite
APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=6993347c0006ead7404d
APPWRITE_API_KEY=your_appwrite_api_key_here
APPWRITE_DATABASE_ID=chizze_db

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
# Explicitly set true only for temporary non-live production testing.
ALLOW_RAZORPAY_TEST_KEYS_IN_PROD=false

# Redis (for caching & rate limiting)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your_jwt_secret_here_change_in_production

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Performance tuning
REQUEST_TIMEOUT_SECONDS=15
MAX_CONNECTIONS=200

# Monitoring (optional — enable in production)
# SENTRY_DSN=https://xxxx@sentry.io/yyyy
# LOG_LEVEL=debug  # debug | info | warn | error

# Firebase Cloud Messaging (HTTP v1 API via Firebase Admin SDK).
# The legacy FCM HTTP API (FCM_SERVER_KEY) was decommissioned by Google
# on 2024-06-20 — it is no longer used. Set both vars below to enable
# push delivery to backgrounded/killed Android and iOS apps.
#
# 1. Firebase Console → Project Settings → Service Accounts → "Generate
#    new private key". Save the JSON file securely on the server.
# 2. Point FIREBASE_CREDENTIALS_JSON at that file's absolute path.
# 3. FIREBASE_PROJECT_ID is the Firebase project ID (not the number).
# FIREBASE_CREDENTIALS_JSON=/etc/chizze/firebase-sa.json
# FIREBASE_PROJECT_ID=chizze-app

# Android App Links (served at /.well-known/assetlinks.json)
ANDROID_APP_PACKAGE=com.chizze.app
# Comma-separated SHA-256 cert fingerprints (Play signing + upload key if needed)
ANDROID_ASSETLINKS_SHA256_FINGERPRINTS=EE:38:5E:00:9F:8B:C1:99:EB:BC:4C:7C:4E:5A:D4:BA:5D:C2:DC:17:E9:64:5A:E8:C7:02:6A:DA:81:CF:F3:EB
